{
  "name": "PaymentTransaction",
  "type": "object",
  "properties": {
    "service_request_id": { "type": "string" },
    "customer_id": { "type": "string" },
    "customer_email": { "type": "string" },
    "paypal_order_id": { "type": "string" },
    "paypal_capture_id": { "type": "string" },
    "amount": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "status": { "type": "string", "enum": ["created", "completed", "failed", "refunded"], "default": "created" },
    "environment": { "type": "string", "enum": ["sandbox", "live"], "default": "sandbox" },
    "captured_at": { "type": "string" }
  },
  "required": ["service_request_id", "customer_id", "paypal_order_id", "amount", "currency", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [{ "customer_id": "{{user.id}}" }, { "user_condition": { "role": "admin" } }] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
