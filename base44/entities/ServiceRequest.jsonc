{
  "name": "ServiceRequest",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "description": "Public quote reference given to the customer"
    },
    "customer_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "service_label": {
      "type": "string"
    },
    "device_class": {
      "type": "string"
    },
    "device_label": {
      "type": "string"
    },
    "device_model": {
      "type": "string"
    },
    "device_count": {
      "type": "number"
    },
    "session_window": {
      "type": "string",
      "description": "Preferred remote session window chosen by the customer"
    },
    "quoted_unit_price": {
      "type": "number"
    },
    "quoted_total": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "ownership_confirmed": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "diagnosing",
        "in_progress",
        "completed",
        "declined"
      ],
      "default": "received"
    }
  },
  "required": [
    "reference",
    "email",
    "service",
    "device_class"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}